# Copy to .env in this directory (actual-helpers/.env).

# === Actual ===
# Pi (helpers container): http://host.docker.internal:5006
#   or http://actual:5006 if both containers share a Docker network
# Mac / laptop: https://ynab.jassie.us
ACTUAL_SERVER_URL="http://host.docker.internal:5006"
ACTUAL_SERVER_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_BUDGET_ID=
ACTUAL_FILE_PASSWORD=
ACTUAL_SERVER_ENCRYPTION_PASSWORD=
ACTUAL_CACHE_DIR="./cache"
NODE_TLS_REJECT_UNAUTHORIZED=0

# === Home Assistant (run.sh failure notify) ===
HA_TOKEN=

# === Plaid ===
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=production
PLAID_COUNTRY_CODES="US,CA"
PLAID_PRODUCTS="transactions,investments"
PLAID_LANGUAGE="en"
APP_PORT=3001
APP_BIND_ADDRESS=127.0.0.1
APP_URL="http://localhost"

# === Questrade (seeds only; rotated tokens live in data/) ===
CASS_QUESTRADE=
JASON_QUESTRADE=

# === Jobs ===
INTEREST_PAYEE_NAME="Loan Interest"
HASDATA_API_KEY=
ZESTIMATE_PAYEE_NAME="Market Correction"

# === ServiceMac / Valon (5th and 20th) ===
# Firebase web API key = the `key=` on identitytoolkit signInWithPassword (persists).
SERVICEMAC_EMAIL=
SERVICEMAC_PASSWORD=
SERVICEMAC_FIREBASE_API_KEY=
SERVICEMAC_FIREBASE_TENANT_ID=servicemac-borrowers-u0cbn
SERVICEMAC_TENANT_SID=
SERVICEMAC_BORROWER_SID=
SERVICEMAC_LOAN_SID=

# === Google Drive backup (rclone) ===
# Remote name must match the [section] in rclone/rclone.conf
RCLONE_REMOTE=gdrive
RCLONE_REMOTE_DIR=backups/actual
# Keep this many days of zips on Drive. 0 = keep all.
BACKUP_KEEP_DAYS=30

# === Unused placeholders (_unused/) ===
KBB_PAYEE_NAME="KBB"
RENTCAST_API_KEY=
RENTCAST_PAYEE_NAME="Market Correction"
INVESTMENT_PAYEE_NAME="Investment"
INVESTMENT_CATEGORY_GROUP_NAME="Income"
INVESTMENT_CATEGORY_NAME="Investment"
